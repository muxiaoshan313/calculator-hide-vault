<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Old PIN"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etOldPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter old PIN"
        android:inputType="numberPassword"
        android:maxLength="12"
        android:minHeight="48dp"
        android:padding="12dp"
        android:textSize="16sp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New PIN"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etNewPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter new PIN (4-12 digits)"
        android:inputType="numberPassword"
        android:maxLength="12"
        android:minHeight="48dp"
        android:padding="12dp"
        android:textSize="16sp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confirm New PIN"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etConfirmNewPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Confirm new PIN"
        android:inputType="numberPassword"
        android:maxLength="12"
        android:minHeight="48dp"
        android:padding="12dp"
        android:textSize="16sp"
        android:background="@android:drawable/edit_text" />

</LinearLayout>


